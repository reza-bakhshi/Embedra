{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embedra:schema:device-catalog-diff:1",
  "title": "Embedra Device Catalog Diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "catalogId", "previousSource", "currentSource", "added", "removed", "changed"
  ],
  "properties": {
    "schemaId": {"const": "urn:embedra:schema:device-catalog-diff:1"},
    "catalogId": {"type": "string", "minLength": 1},
    "previousSource": {"$ref": "device-catalog-snapshot-v1.schema.json#/$defs/source"},
    "currentSource": {"$ref": "device-catalog-snapshot-v1.schema.json#/$defs/source"},
    "added": {
      "type": "array",
      "items": {"$ref": "device-catalog-snapshot-v1.schema.json#/$defs/device"}
    },
    "removed": {
      "type": "array",
      "items": {"$ref": "device-catalog-snapshot-v1.schema.json#/$defs/device"}
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviceId", "previous", "current"],
        "properties": {
          "deviceId": {"type": "string", "minLength": 1},
          "previous": {"$ref": "device-catalog-snapshot-v1.schema.json#/$defs/device"},
          "current": {"$ref": "device-catalog-snapshot-v1.schema.json#/$defs/device"}
        }
      }
    }
  }
}
