{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embedra:schema:pack-manifest:1",
  "title": "Embedra Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "packId",
    "version",
    "contentDigest",
    "supportedDevices",
    "provenance",
    "files"
  ],
  "properties": {
    "schemaId": {"const": "urn:embedra:schema:pack-manifest:1"},
    "packId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "contentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supportedDevices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision", "license", "transformation", "redistribution"],
      "properties": {
        "source": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "transformation": {"type": "string", "minLength": 1},
        "redistribution": {"enum": ["ALLOWED", "RESTRICTED", "PROHIBITED"]}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
