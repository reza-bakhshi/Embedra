{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embedra:schema:canonical-report:1",
  "title": "Embedra Canonical Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "toolBuild",
    "inputs",
    "providers",
    "packs",
    "validations",
    "mappings",
    "appliedSymbols",
    "appliedTypes",
    "metadata",
    "executionTopology",
    "findings",
    "diagnostics",
    "reproducibility"
  ],
  "properties": {
    "schemaId": {"const": "urn:embedra:schema:canonical-report:1"},
    "toolBuild": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "packs": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "validations": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "mappings": {"type": "array", "items": {"$ref": "#/$defs/mapping"}},
    "appliedSymbols": {"type": "array", "items": {"$ref": "#/$defs/appliedSymbol"}},
    "appliedTypes": {"type": "array", "items": {"$ref": "#/$defs/appliedType"}},
    "metadata": {"type": "object", "additionalProperties": {"type": "string"}},
    "executionTopology": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "execution-topology-v1.schema.json"}
      ]
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redactionEnabled", "enabledEnrichments", "locale", "timeZone"],
      "properties": {
        "redactionEnabled": {"type": "boolean"},
        "enabledEnrichments": {"type": "array", "items": {"type": "string"}},
        "locale": {"const": "en-US"},
        "timeZone": {"const": "UTC"}
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "length"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "length": {"type": "integer", "minimum": 0}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "length"],
      "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "length": {"type": "integer", "minimum": 0}
      }
    },
    "addressRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addressSpace", "start", "length"],
      "properties": {
        "addressSpace": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "length": {"type": "integer", "minimum": 0}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "detail"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "message", "evidence"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRange", "targetRange", "permissions", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sourceRange": {"$ref": "#/$defs/sourceRange"},
        "targetRange": {"$ref": "#/$defs/addressRange"},
        "permissions": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "appliedSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "addressSpace", "address", "provenance"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "addressSpace": {"type": "string", "minLength": 1},
        "address": {"type": "integer", "minimum": 0},
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "appliedType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "categoryPath", "provenance"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "categoryPath": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "scanner", "category", "severity", "confidence", "address", "explanation", "secret"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scanner": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["VERIFIED", "DERIVED", "HEURISTIC", "USER_SELECTED", "UNKNOWN"]},
        "address": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/addressRange"}]},
        "explanation": {"type": "string", "minLength": 1},
        "secret": {"type": "boolean"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "sourceRange"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["INFO", "WARNING", "ERROR"]},
        "message": {"type": "string", "minLength": 1},
        "sourceRange": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sourceRange"}]}
      }
    }
  }
}
