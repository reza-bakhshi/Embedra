{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embedra:schema:crypto-signature-pack:1",
  "title": "Embedra Crypto Signature Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "packId",
    "version",
    "description",
    "signatures",
    "integrityDigest"
  ],
  "properties": {
    "schemaId": {"const": "urn:embedra:schema:crypto-signature-pack:1"},
    "packId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "description": {"type": "string", "minLength": 1},
    "integrityDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "version", "license", "sourceFile", "sourceSha256"],
      "properties": {
        "library": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "sourceFile": {"type": "string", "minLength": 1},
        "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "library",
        "algorithm",
        "role",
        "isa",
        "compiler",
        "optimization",
        "confidence",
        "provenance",
        "pattern",
        "mask"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "library": {
          "type": "string",
          "enum": [
            "MBEDTLS",
            "WOLFSSL",
            "BEARSSL",
            "TINYCRYPT",
            "MONOCYPHER",
            "MICRO_ECC",
            "LIBTOMCRYPT",
            "OPENSSL",
            "ESP_IDF",
            "STM32_HAL",
            "PICO_SDK",
            "CUSTOM"
          ]
        },
        "algorithm": {"type": "string", "minLength": 1},
        "role": {
          "type": "string",
          "enum": [
            "ALGORITHM_IMPLEMENTATION",
            "WRAPPER",
            "CALLER_USE_SITE",
            "INLINED_IDIOM",
            "CONSTANT_TABLE",
            "KEY_SCHEDULE",
            "IV_NONCE",
            "PUBLIC_KEY",
            "SECRET_KEY_CANDIDATE",
            "CERTIFICATE",
            "RANDOM_GENERATOR",
            "PROTOCOL_ENCODING"
          ]
        },
        "isa": {
          "type": "string",
          "enum": ["ARM_THUMB", "XTENSA", "RISCV32", "GENERIC"]
        },
        "compiler": {
          "type": "string",
          "enum": ["GCC", "CLANG", "ARMCC", "IAR", "ANY"]
        },
        "optimization": {
          "type": "string",
          "enum": ["O0", "O1", "O2", "O3", "Os", "Oz", "ANY"]
        },
        "confidence": {
          "type": "string",
          "enum": ["CONFIRMED", "LIKELY", "POSSIBLE"]
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "pattern": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{2}){8,}$"},
        "mask": {"type": "string", "pattern": "^(?:00|ff|FF){8,}$"},
        "crossReferenceSymbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
